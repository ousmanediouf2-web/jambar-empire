{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Jambar Empire",
    "version": "1.0.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.senegambie.jambarempire",
      "active": true,
      "targets": ["msi"]
    },
    "windows": [
      {
        "title": "Jambar Empire",
        "width": 1280,
        "height": 800
      }
    ]
  }
}
